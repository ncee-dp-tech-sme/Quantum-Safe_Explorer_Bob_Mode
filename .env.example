# Settings for scripts/compare_bob_dist.sh (all optional; defaults shown). Copy to .env to override.
# Paths are relative to the project root.
BOB_DIR=.bob
DIST_BOB_DIR=dist/.bob
DIST_ROOT=dist
# Space-separated root-level files that are mirrored into DIST_ROOT
ROOT_FILES="README.md requirements.txt bob-qse-remediation-1.0.0.zip"
# Space-separated basenames to ignore
EXCLUDES=".DS_Store"
# Space-separated basenames that must never be copied blindly (credentials)
SENSITIVE_FILES="mcp.json"
REPORT_DIR=reports
MAX_DIFF_LINES=40
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
